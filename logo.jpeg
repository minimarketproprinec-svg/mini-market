<!-- Bloque de Identidad Corporativa -->
<div class="brand-header">
    <img src="logo.jpeg" alt="Mega Minimarket Propinec" class="main-logo">
</div>

<style>
    .brand-header {
        background: white;
        padding: 10px 0;
        display: flex;
        justify-content: center;
        align-items: center;
        border-bottom: 2px solid #f1f1f1;
        width: 100%;
    }
    .main-logo {
        height: 65px; /* Altura ideal para que se vea claro pero no gigante */
        width: auto;
        object-fit: contain;
        transition: transform 0.3s ease;
    }
    .main-logo:hover {
        transform: scale(1.05); /* Efecto suave al pasar el mouse */
    }
    @media (max-width: 480px) {
        .main-logo { height: 50px; } /* Un poco más pequeña en celulares */
    }
</style>
